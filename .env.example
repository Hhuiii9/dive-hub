# Dive Hub & Marine Services — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real credentials.

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# ─── App ──────────────────────────────────────────────────────────────────────
ADMIN_FRONTEND_URL=

# ─── Maps (public, safe to expose in browser) ─────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_URL=

# ─── Admin Scripts (do NOT commit actual values) ──────────────────────────────
# Used only with: npm run admin:reset-password
# ADMIN_EMAIL=
# NEW_ADMIN_PASSWORD=
